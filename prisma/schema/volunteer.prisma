/// A volunteering profile. NOT the authenticated principal — see `User`.
///
/// `userId` is optional (and unique) so a profile can exist for someone with no
/// account, e.g. seeded historical volunteers. Always look one up by
/// `{ where: { userId } }`; passing a `User.id` as `Volunteer.id` silently
/// matches nothing.
///
/// `approvalStatus` is the gate on volunteer-only events, and is separate from
/// holding the VOLUNTEER role: applying grants the role and creates this row as
/// PENDING, and only staff approval (after a training event) moves it to
/// APPROVED. REJECTED is not a ban — rejected volunteers can still attend
/// another training and be reconsidered.
///
/// Relations are deliberately not cascading, so deleting a volunteer means
/// clearing the join tables and hour logs first (see `user/me.delete.ts`).
model Volunteer {
  id     String  @id @default(uuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique
  isActive       Boolean @default(true)

  approvalStatus ApprovalStatus @default(PENDING)

  gender         Gender?
  ethinicity     Ethinicity?
  languages      Volunteer_Language[]
  availabilities Volunteer_Availability[]
  volunteerAreas Volunteer_VolunteerArea[]
  certifications Volunteer_Certification[]
  hourLogs       Volunteer_Hour_Log[]
  events         RSVP[]
  slotSignups    Event_Time_Slot_Signup[]

  otherVolunteerAreaDescription String?
  otherCertificationDescription String?

  emergencyContactName1  String?
  emergencyContactPhone1 String?
  emergencyContactName2  String?
  emergencyContactPhone2 String?

  @@map("volunteers")
}

model Volunteer_Language {
  language    Language
  Volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  volunteerId String

  @@id([volunteerId, language])
  @@map("volunteer_languages")
}

/// Hours logged by (or on behalf of) a volunteer, pending staff approval.
///
/// `eventId` and `eventName` are alternatives, and both are nullable: a log
/// either points at a real `Event` or carries a free-text description of ad-hoc
/// work. Code that reads the event title must fall back —
/// `log.event?.title ?? log.eventName` — since assuming an event is present is
/// a live crash in `/api/volunteer/logs`.
///
/// Only APPROVED logs count toward the hour totals shown in the admin member
/// list; some UI sums all statuses, so figures can legitimately differ.
///
/// `program` is the grant-reporting dimension ("hours by program"). It's
/// nullable and unset on every historical row, so the reports don't read it
/// directly — `server/utils/reporting.ts` owns the fallback chain (explicit
/// program → the volunteer's single volunteer area → unassigned). Setting it on
/// a log is what makes that attribution exact rather than inferred.
///
/// `approvedAt` is stamped by the review endpoints when a log leaves PENDING,
/// so the approval-latency stat measures submission→decision rather than
/// submission→last-edit. Null on rows decided before it existed, and those rows
/// are simply excluded from the latency median rather than guessed at.
model Volunteer_Hour_Log {
  id             Int            @id @default(autoincrement())
  volunteer      Volunteer      @relation(fields: [volunteerId], references: [id])
  volunteerId    String
  event          Event?          @relation(fields: [eventId], references: [id])
  eventId        String?
  eventName      String?
  date           DateTime
  hours          Float
  approvalStatus ApprovalStatus @default(PENDING)
  program        VolunteerArea?
  comment        String?
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([approvalStatus])
  @@index([volunteerId, date])
  @@map("volunteer_hour_logs")
}

model Volunteer_Availability {
  volunteer    Volunteer    @relation(fields: [volunteerId], references: [id])
  volunteerId  String
  availability Availability

  @@id([volunteerId, availability])
  @@map("volunteer_availabilities")
}

model Volunteer_VolunteerArea {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  volunteerArea VolunteerArea

  @@id([volunteerId, volunteerArea])
  @@map("volunteer_volunteer_areas")
}

model Volunteer_Certification {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  certification Certification

  @@id([volunteerId, certification])
  @@map("volunteer_certifications")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Availability {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
}

/// NOTE: misspelled ("Ethinicity"). The typo is mirrored deliberately
/// throughout the app — Prisma column, API payloads, and form fields — so it
/// stays consistent. Correcting it requires a migration plus a rename across
/// every layer, not a local fix.
enum Ethinicity {
  WHITE
  BLACK_OR_AFRICAN_AMERICAN
  ALASKA_NATIVE
  ASIAN
  NATIVE_HAWAIIAN_OR_OTHER_PACIFIC_ISLANDER
  MIDDLE_EASTERN_OR_NORTH_AFRICAN
  HISPANIC
}

/// Shared by `Volunteer.approvalStatus` (cleared to volunteer?) and
/// `Volunteer_Hour_Log.approvalStatus` (are these hours counted?). Both default
/// to PENDING, so nothing is approved implicitly.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  CHINESE
  JAPANESE
  HINDI
  ARABIC
  RUSSIAN
  PORTUGUESE
  ITALIAN
  KOREAN
  DUTCH
  SWEDISH
  NORWEGIAN
  DANISH
  FINNISH
  POLISH
  TURKISH
  GREEK
  HEBREW
  VIETNAMESE
  THAI
  INDONESIAN
  MALAY
  FILIPINO
}

enum VolunteerArea {
  CLINIC_SUPPORT
  MOBILE_CLINIC_OUTREACH
  EVENT_SUPPORT
  COMMUNITY_OUTREACH
  ADMINISTRATIVE_TASKS
  OTHER
}

enum Certification {
  MEDICAL_CODING
  DOULA_CERTIFICATION
  CDL
  CHILDBIRTH_EDUCATOR
  CERTIFIED_TEACHER_EDUCATOR
  IBCLC
  GRAPHIC_DESIGN
  OTHER
}