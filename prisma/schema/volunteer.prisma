model Volunteer {
  id     String  @id @default(uuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique
  isActive       Boolean @default(true)

  approvalStatus ApprovalStatus @default(PENDING)

  gender         Gender?
  ethinicity     Ethinicity?
  languages      Volunteer_Language[]
  availabilities Volunteer_Availability[]
  volunteerAreas Volunteer_VolunteerArea[]
  certifications Volunteer_Certification[]
  hourLogs       Volunteer_Hour_Log[]
  events         RSVP[]
  slotSignups    Event_Time_Slot_Signup[]

  otherVolunteerAreaDescription String?
  otherCertificationDescription String?

  emergencyContactName1  String?
  emergencyContactPhone1 String?
  emergencyContactName2  String?
  emergencyContactPhone2 String?

  @@map("volunteers")
}

model Volunteer_Language {
  language    Language
  Volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  volunteerId String

  @@id([volunteerId, language])
  @@map("volunteer_languages")
}

model Volunteer_Hour_Log {
  id             Int            @id @default(autoincrement())
  volunteer      Volunteer      @relation(fields: [volunteerId], references: [id])
  volunteerId    String
  event          Event?          @relation(fields: [eventId], references: [id])
  eventId        String?
  eventName      String?
  date           DateTime
  hours          Float
  approvalStatus ApprovalStatus @default(PENDING)
  comment        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("volunteer_hour_logs")
}

model Volunteer_Availability {
  volunteer    Volunteer    @relation(fields: [volunteerId], references: [id])
  volunteerId  String
  availability Availability

  @@id([volunteerId, availability])
  @@map("volunteer_availabilities")
}

model Volunteer_VolunteerArea {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  volunteerArea VolunteerArea

  @@id([volunteerId, volunteerArea])
  @@map("volunteer_volunteer_areas")
}

model Volunteer_Certification {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  certification Certification

  @@id([volunteerId, certification])
  @@map("volunteer_certifications")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Availability {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
}

enum Ethinicity {
  WHITE
  BLACK_OR_AFRICAN_AMERICAN
  ALASKA_NATIVE
  ASIAN
  NATIVE_HAWAIIAN_OR_OTHER_PACIFIC_ISLANDER
  MIDDLE_EASTERN_OR_NORTH_AFRICAN
  HISPANIC
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  CHINESE
  JAPANESE
  HINDI
  ARABIC
  RUSSIAN
  PORTUGUESE
  ITALIAN
  KOREAN
  DUTCH
  SWEDISH
  NORWEGIAN
  DANISH
  FINNISH
  POLISH
  TURKISH
  GREEK
  HEBREW
  VIETNAMESE
  THAI
  INDONESIAN
  MALAY
  FILIPINO
}

enum VolunteerArea {
  CLINIC_SUPPORT
  MOBILE_CLINIC_OUTREACH
  EVENT_SUPPORT
  COMMUNITY_OUTREACH
  ADMINISTRATIVE_TASKS
  OTHER
}

enum Certification {
  MEDICAL_CODING
  DOULA_CERTIFICATION
  CDL
  CHILDBIRTH_EDUCATOR
  CERTIFIED_TEACHER_EDUCATOR
  IBCLC
  GRAPHIC_DESIGN
  OTHER
}