/// A volunteering profile. NOT the authenticated principal — see `User`.
///
/// `userId` is optional (and unique) so a profile can exist for someone with no
/// account, e.g. seeded historical volunteers. Always look one up by
/// `{ where: { userId } }`; passing a `User.id` as `Volunteer.id` silently
/// matches nothing.
///
/// `approvalStatus` is the gate on volunteer-only events, and is separate from
/// holding the VOLUNTEER role: applying grants the role and creates this row as
/// PENDING, and only staff approval (after a training event) moves it to
/// APPROVED. REJECTED is not a ban — rejected volunteers can still attend
/// another training and be reconsidered.
///
/// Relations are deliberately not cascading, so deleting a volunteer means
/// clearing the join tables and hour logs first (see `user/me.delete.ts`).
model Volunteer {
  id     String  @id @default(uuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique
  isActive       Boolean @default(true)

  approvalStatus ApprovalStatus @default(PENDING)

  gender         Gender?
  ethinicity     Ethinicity?
  languages      Volunteer_Language[]
  availabilities Volunteer_Availability[]
  volunteerAreas Volunteer_VolunteerArea[]
  certifications Volunteer_Certification[]
  hourLogs       Volunteer_Hour_Log[]
  events         RSVP[]
  slotSignups    Event_Time_Slot_Signup[]
  applications   Volunteer_Application[]

  otherVolunteerAreaDescription String?
  otherCertificationDescription String?

  /// What the volunteer actually wrote for race/ethnicity and languages, kept
  /// verbatim alongside the enum columns above.
  ///
  /// Both questions are free text on the paper/Monday form but enums here, and
  /// the enums cannot represent everything people write: "Two or more races",
  /// "Black/Indigenous", "Italian-American", or a language the `Language` enum
  /// has no member for (Telugu, Amharic, ASL, Yoruba, Farsi, Bengali...). The
  /// importer maps what it can and falls back to `OTHER`, which would otherwise
  /// throw the answer away — a lossy demographic figure is worse than none in a
  /// grant report. Null for anyone who filled in the in-app form, where the
  /// answer came from a dropdown and the enum is already exact.
  ethinicityRaw String?
  languagesRaw  String?

  emergencyContactName1  String?
  emergencyContactPhone1 String?
  emergencyContactName2  String?
  emergencyContactPhone2 String?

  @@map("volunteers")
}

model Volunteer_Language {
  language    Language
  Volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  volunteerId String

  @@id([volunteerId, language])
  @@map("volunteer_languages")
}

/// Hours logged by (or on behalf of) a volunteer, pending staff approval.
///
/// `eventId` and `eventName` are alternatives, and both are nullable: a log
/// either points at a real `Event` or carries a free-text description of ad-hoc
/// work. Code that reads the event title must fall back —
/// `log.event?.title ?? log.eventName` — since assuming an event is present is
/// a live crash in `/api/volunteer/logs`.
///
/// Only APPROVED logs count toward the hour totals shown in the admin member
/// list; some UI sums all statuses, so figures can legitimately differ.
///
/// `program` is the grant-reporting dimension ("hours by program"). It's
/// nullable and unset on every historical row, so the reports don't read it
/// directly — `server/utils/reporting.ts` owns the fallback chain (explicit
/// program → the volunteer's single volunteer area → unassigned). Setting it on
/// a log is what makes that attribution exact rather than inferred.
///
/// `approvedAt` is stamped by the review endpoints when a log leaves PENDING,
/// so the approval-latency stat measures submission→decision rather than
/// submission→last-edit. Null on rows decided before it existed, and those rows
/// are simply excluded from the latency median rather than guessed at.
model Volunteer_Hour_Log {
  id             Int            @id @default(autoincrement())
  volunteer      Volunteer      @relation(fields: [volunteerId], references: [id])
  volunteerId    String
  event          Event?          @relation(fields: [eventId], references: [id])
  eventId        String?
  eventName      String?
  date           DateTime
  hours          Float
  approvalStatus ApprovalStatus @default(PENDING)
  program        VolunteerArea?
  comment        String?
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([approvalStatus])
  @@index([volunteerId, date])
  @@map("volunteer_hour_logs")
}

model Volunteer_Availability {
  volunteer    Volunteer    @relation(fields: [volunteerId], references: [id])
  volunteerId  String
  availability Availability

  @@id([volunteerId, availability])
  @@map("volunteer_availabilities")
}

model Volunteer_VolunteerArea {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  volunteerArea VolunteerArea

  @@id([volunteerId, volunteerArea])
  @@map("volunteer_volunteer_areas")
}

model Volunteer_Certification {
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  volunteerId   String
  certification Certification

  @@id([volunteerId, certification])
  @@map("volunteer_certifications")
}

/// One submitted volunteer application, kept as a record of what the person
/// actually answered and when.
///
/// `Volunteer` is a living profile — staff edit it, volunteers update it, and
/// it says nothing about when or on what terms someone applied. This model is
/// the opposite: an append-only row per submission, never rewritten. It exists
/// because the historical applications (exported from Monday.com) carry things
/// the profile has nowhere to put — the legal acknowledgements, the signature
/// image, the training answers, and above all `submittedAt`, without which
/// every imported volunteer looks like they applied on the day of the import.
///
/// Several rows can point at one `Volunteer`: people reapply, and 35 of the 262
/// addresses in the first import had submitted more than once. The profile
/// reflects their most recent non-empty answers; every submission is still here.
///
/// `(email, submittedAt)` is unique, which is what makes importing the same
/// file twice a no-op rather than a duplicate set. The email is stored on the
/// row (not just reached through `volunteer.user`) so that key survives a row
/// whose volunteer could not be created, and so re-running an import can match
/// before any `User` exists.
///
/// `rawRow` is the entire source record as JSON. Mapping free text onto enums
/// is lossy and the mapper will be wrong about someone; this is what makes that
/// recoverable without going back to Monday.com, which is being retired.
model Volunteer_Application {
  id          String     @id @default(uuid())
  /// `SetNull` rather than cascade so a profile deleted by staff doesn't
  /// silently take the application history with it. A volunteer deleting their
  /// own account is the other case, and `user/me.delete.ts` removes these rows
  /// outright — keeping someone's name, email and signature after they asked
  /// for the account to be erased is not an archive, it's a leak.
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  volunteerId String?

  /// When the applicant submitted, not when the row was written here.
  submittedAt DateTime
  /// Where the row came from: `MONDAY_CSV` for an import, `APP` for the
  /// in-app form.
  source      String

  firstName String?
  lastName  String?
  /// Normalised (trimmed, lower-cased) like every other stored address — see
  /// `server/utils/normalizeEmail.ts`.
  email     String
  phone     String?

  /// Free text as submitted. The enum-mapped equivalents live on `Volunteer`.
  ethinicityRaw       String?
  languagesRaw        String?
  /// The single free-text field the Monday form collected; the profile splits
  /// it into name/phone pairs and that split is a guess.
  emergencyContactRaw String?

  volunteeredBefore     Boolean?
  attendedTraining      Boolean?
  trainingDate          DateTime?
  preferredTrainingDate String?

  /// The acknowledgements, as answered. Null where the form of the day didn't
  /// ask — 79 of the earliest submissions never saw the health and safety
  /// question, which is not the same as declining it.
  ageEligibility            Boolean?
  healthSafety              Boolean?
  backgroundCheckConsent    Boolean?
  ongoingEducationCommitment Boolean?
  acceptanceDiscretion      Boolean?
  missionValues             Boolean?

  /// Monday.com `protected_static` URLs. They will stop resolving when that
  /// board is retired, so treat them as a pointer to fetch and re-host, not as
  /// a durable asset.
  codeOfConductSignatureURL String?
  signatureURL              String?
  submissionLink            String?

  /// The source record verbatim, as a JSON object of column → value.
  rawRow String

  importedAt       DateTime @default(now())
  importedByUserId String?

  @@unique([email, submittedAt])
  @@index([volunteerId])
  @@map("volunteer_applications")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Availability {
  WEEKDAY_MORNING
  WEEKDAY_AFTERNOON
  WEEKDAY_EVENING
  WEEKEND_MORNING
  WEEKEND_AFTERNOON
}

/// NOTE: misspelled ("Ethinicity"). The typo is mirrored deliberately
/// throughout the app — Prisma column, API payloads, and form fields — so it
/// stays consistent. Correcting it requires a migration plus a rename across
/// every layer, not a local fix.
enum Ethinicity {
  WHITE
  BLACK_OR_AFRICAN_AMERICAN
  ALASKA_NATIVE
  ASIAN
  NATIVE_HAWAIIAN_OR_OTHER_PACIFIC_ISLANDER
  MIDDLE_EASTERN_OR_NORTH_AFRICAN
  HISPANIC
  /// Someone who named more than one of the categories above. Distinct from
  /// OTHER, which is "none of these" — including the answers that are not an
  /// ethnicity at all (four people typed the city they live in).
  TWO_OR_MORE
  OTHER
}

/// Shared by `Volunteer.approvalStatus` (cleared to volunteer?) and
/// `Volunteer_Hour_Log.approvalStatus` (are these hours counted?). Both default
/// to PENDING, so nothing is approved implicitly.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  CHINESE
  JAPANESE
  HINDI
  ARABIC
  RUSSIAN
  PORTUGUESE
  ITALIAN
  KOREAN
  DUTCH
  SWEDISH
  NORWEGIAN
  DANISH
  FINNISH
  POLISH
  TURKISH
  GREEK
  HEBREW
  VIETNAMESE
  THAI
  INDONESIAN
  MALAY
  FILIPINO
  /// A language this enum has no member for. The importer sets it whenever it
  /// cannot place a fragment of the free-text answer, and the words themselves
  /// survive on `Volunteer.languagesRaw` — Telugu alone accounts for twelve
  /// volunteers, so silently dropping them would misreport who can interpret.
  OTHER
}

enum VolunteerArea {
  CLINIC_SUPPORT
  MOBILE_CLINIC_OUTREACH
  EVENT_SUPPORT
  COMMUNITY_OUTREACH
  ADMINISTRATIVE_TASKS
  OTHER
}

enum Certification {
  MEDICAL_CODING
  DOULA_CERTIFICATION
  CDL
  CHILDBIRTH_EDUCATOR
  CERTIFIED_TEACHER_EDUCATOR
  IBCLC
  GRAPHIC_DESIGN
  OTHER
}