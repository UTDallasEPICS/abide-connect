model Event {
  id              String   @id @default(uuid())
  title           String
  shortDesc       String?
  description     String?
  startTime       DateTime
  endTime         DateTime
  location        Location @relation(fields: [locationId], references: [id])
  locationId      String
  calendarURL     String?
  calendarEventId String?
  allowVolunteers Boolean
  allowAttendees  Boolean
  isTraining      Boolean @default(false)
  logsGenerated   Boolean @default(false)

  mobileClinic   MobileClinic? @relation(fields: [mobileClinicId], references: [id])
  mobileClinicId String?

  eventAssets    Event_Asset[]
  participants   RSVP[]
  volunteerHours Volunteer_Hour_Log[]
  guestRSVPs     GuestRSVP[]
  timeSlots      Event_Time_Slot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("events")
}

model Event_Asset {
  event    Event  @relation(fields: [eventId], references: [id])
  eventId  String
  imageUrl String

  @@id([eventId, imageUrl])
  @@map("event_assets")
}

model RSVP {
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  event       Event      @relation(fields: [eventId], references: [id])
  eventId     String
  isVolunteer Boolean    @default(false)
  volunteerId String?
  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])

  @@id([userId, eventId])
  @@map("rsvps")
}

/// A shift an admin drew on an event, e.g. 8am-12pm on an 8am-4pm event.
/// Blocks are hand-authored rather than generated, so they may overlap each
/// other and vary in length — there is deliberately no unique constraint.
model Event_Time_Slot {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  startTime DateTime
  endTime   DateTime
  capacity  Int      @default(1)
  note      String?

  signups Event_Time_Slot_Signup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([eventId])
  @@map("event_time_slots")
}

/// One volunteer claiming one block. Cancelled rows are kept rather than
/// deleted, so re-signing up is an upsert that flips `status` back to
/// CONFIRMED — and every capacity count must filter on CONFIRMED, or
/// cancelled rows silently consume capacity.
model Event_Time_Slot_Signup {
  id          String          @id @default(uuid())
  timeSlot    Event_Time_Slot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  timeSlotId  String
  volunteer   Volunteer       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  volunteerId String

  status          SlotSignupStatus @default(CONFIRMED)
  removedByUserId String?
  removedAt       DateTime?
  removalReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([timeSlotId, volunteerId])
  @@index([volunteerId])
  @@map("event_time_slot_signups")
}

/// Why a signup is no longer active. A volunteer dropping out and staff
/// removing someone are deliberately distinct.
enum SlotSignupStatus {
  CONFIRMED
  CANCELLED_BY_VOLUNTEER
  REMOVED_BY_ADMIN
}

model GuestRSVP {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  email       String
  isVolunteer Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("guest_rsvps")
}
