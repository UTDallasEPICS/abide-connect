model User {
  id            String              @id @default(uuid())
  name          String?
  email         String              @unique
  phone         String?
  adminNote     String?
  emailVerified Boolean             @default(false)
  imageURL      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  roles         User_Role[]
  RSVPs         RSVP[]
  notifications User_Notification[]
  sessions      Session[]
  accounts      Account[]
  volunteer     Volunteer?

  // Push notification preferences, managed from /settings.
  pushEnabled       Boolean          @default(false)
  pushScope         PushScope        @default(BOTH)
  pushSubscriptions PushSubscription[]

  /// Opt-in for the emailed 24-hour reminder before an event they signed up
  /// for. Off by default — push is the primary channel and mail is the noisier
  /// one, so nobody gets it without asking in /settings.
  emailRemindersEnabled Boolean @default(false)

  eventReminders Event_Reminder[]

  @@map("users")
}

model User_Role {
  role   UserRole
  user   User     @relation(fields: [userId], references: [id])
  userId String
  active Boolean

  @@id([userId, role])
  @@map("user_roles")
}

model User_Notification {
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String
  isRead         Boolean      @default(false)

  @@id([userId, notificationId])
  @@map("user_notifications")
}

enum UserRole {
  USER
  ADMIN
  VOLUNTEER
}
