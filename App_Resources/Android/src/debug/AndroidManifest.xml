<?xml version="1.0" encoding="utf-8"?>
<!-- nuxt-native: dev-only cleartext exception for useWebSocket() -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The hello-world App_Resources template already declares
         android:networkSecurityConfig="@xml/network_security" on <application>
         in src/main. Without tools:replace the manifest merger fails with
         "Attribute application@networkSecurityConfig ... is also present".
         tools:replace makes this debug-only overlay win for debug builds,
         leaving src/main's config for release. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
