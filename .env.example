BETTER_AUTH_SECRET=<secret_here>
BETTER_AUTH_URL=<base_url>

DATABASE_URL="./prisma/dev.db"
IMAGE_STORAGE_PATH=<local_absolute_path>
IMAGE_URL_PATH=<web_absolute_path>

EMAIL_HOST=          # SMTP server hostname, e.g. smtp.gmail.com
EMAIL_PORT=          # Usually 587 (STARTTLS) or 465 (SSL)
EMAIL_USER=          # Email address used as the sender
EMAIL_PASS=          # Password or app-specific password for the sender account
EMAIL_FROM=          # "From" address shown in the inbox (can be same as EMAIL_USER)